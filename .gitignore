# ===========================================================================
# Freelance workspace
# Umbrella ignore file for the nested projects under Notes/, Platforms/,
# Showcase/ and Showcase/Other/. Media (images, video, PSD, PDF) is tracked
# on purpose and is NOT ignored here.
# ===========================================================================

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.suo
*.swp
*.swo
*.swn
*~

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# Local databases
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------------
# Node / JS / TS
# ---------------------------------------------------------------------------
node_modules/
bower_components/
jspm_packages/
.npm/
.pnpm-store/
.yarn/
.pnp.*
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.cache/
coverage/
.nyc_output/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Sass / PostCSS caches
.sass-cache/

# ---------------------------------------------------------------------------
# Env files & secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# ---------------------------------------------------------------------------
# Logs / temp / editor backups
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# ---------------------------------------------------------------------------
# Nested git repo: Showcase/OG is registered as a submodule (pointer tracked
# in .gitmodules). Its own .gitignore governs files inside it.
# ---------------------------------------------------------------------------
